{
  "extends": "../tsconfig.settings.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["src"],
  "exclude": ["remotion.config.ts"],
  "references": [
    { "path": "../core" },
    { "path": "../cli" }
  ]
}
